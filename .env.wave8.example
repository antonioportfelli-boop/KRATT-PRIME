# Copy to .env.wave8 in the protected staging runtime only. Never commit the real file.
APP_ENV=staging
HOST=127.0.0.1
PORT=8787

# Telegram BotFather token and webhook secret. Generate a separate long random secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Numeric Telegram bot user ID returned by getMe.
TELEGRAM_BOT_ID=
# Channel IDs allowed to send competitive intelligence, comma-separated.
TELEGRAM_ALLOWED_CHANNEL_IDS=-1001234567890
TELEGRAM_RATE_LIMIT_SALT=
# Shared PostgreSQL ingress limit: requests per peer per fixed window.
TELEGRAM_INGRESS_RATE_LIMIT=30
TELEGRAM_INGRESS_RATE_WINDOW_MS=60000

# Public HTTPS webhook URL. TLS must terminate at the server or trusted reverse proxy.
WEBHOOK_PUBLIC_URL=https://staging.example.com/webhooks/telegram/competitive

# PostgreSQL staging DB. Require TLS certificate validation; do not add sslmode/sslrootcert query parameters.
DATABASE_URL=postgresql://kratt_staging:REPLACE_ME@db.example.com:5432/kratt_staging
# Optional CA file for a private managed DB CA.
DATABASE_CA_CERT_PATH=
# Separate short-lived / migration-admin connection. Never use this in the running server.
DATABASE_MIGRATION_URL=postgresql://kratt_migrator:REPLACE_ME@db.example.com:5432/kratt_staging
DATABASE_MIGRATION_CA_CERT_PATH=

# OpenAI Responses API. The parser uses no tools and only emits the strict JSON schema.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra
# Explicit opt-in: Telegram post text is sent to OpenAI Responses API for parsing.
WAVE8_ALLOW_TELEGRAM_TEXT_TO_OPENAI=false

# Exact official source host allowlist; parser URLs outside these hosts are rejected.
COMPETITOR_SOURCE_ALLOWLIST=salesforce.com,microsoft.com,openai.com,servicenow.com,google.com
MIN_INDEPENDENT_SOURCES=2

# External writes are disabled by default. Set true only for explicit staging webhook setup.
WAVE8_ENABLE_WEBHOOK_WRITES=false
WAVE8_ALLOW_WEBHOOK_REPLACE=false
# Wave 9 migration command requires APP_ENV=staging, WAVE9_APPLY_STAGING_MIGRATIONS=true and expected DB name.
WAVE9_APPLY_STAGING_MIGRATIONS=false
WAVE9_EXPECTED_DATABASE=kratt_staging
# Legacy Wave 8 opt-in variables remain accepted by the migration runner if already configured.
WAVE8_APPLY_STAGING_MIGRATIONS=false
WAVE8_EXPECTED_DATABASE=kratt_staging
